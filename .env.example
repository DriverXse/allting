# Documentation only. Local setup creates .dev.vars; production uses host secrets.
# Never use the original operator's account, project, domain or credentials.
ALLTING_ORIGIN=
ALLTING_AUTH_METHOD=password
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
BETTER_AUTH_SECRET=
ADMIN_EMAIL=
# Alternative production magic links require a verified sending domain.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Loopback development only; never set this in production.
FIREBASE_AUTH_EMULATOR=
